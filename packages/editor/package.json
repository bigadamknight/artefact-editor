{
  "name": "@artefact-editor/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind-preset": {
      "default": "./tailwind-preset.js"
    }
  },
  "files": [
    "dist",
    "tailwind-preset.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@artefact-editor/contract": "0.1.0",
    "@artefact-editor/core": "0.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
